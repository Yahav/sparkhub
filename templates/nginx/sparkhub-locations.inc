# The SparkHub site, generated by ./install.sh from templates/nginx/sparkhub-locations.inc.
# Shared by the public name and the other names (included in every 443 server).
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32m;

    # Prometheus metrics never leave the host
    location = /metrics { return 404; }
    location /internal/ { return 404; }       # same-host endpoints (Grafana alert relay)

    # OpenAI API: streaming, long requests
    location /v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    # MCP: a switch through the tool waits for the new model (up to ~20 min with drain)
    location = /mcp {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1500s;
    }

    location ~ ^/login(/totp|/enroll)?$ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
    }

    # Dashboard
    location / {
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    # --- admin tools behind the SparkHub admin session ---
    location = /_auth {
        internal;
        proxy_pass http://hub/auth/check;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header X-Original-URI $request_uri;
    }
    location @login { return 302 /login?next=$request_uri; }

    location /grafana/ {
        auth_request /_auth;
        auth_request_set $sparkhub_user $upstream_http_x_auth_user;
        error_page 401 = @login;
        proxy_pass http://127.0.0.1:{{GRAFANA_PORT}};
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header X-WEBAUTH-USER $sparkhub_user;   # overrides any client-sent value
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

{{#ARCANE}}
    # Arcane (Docker UI): our fork serves /arcane (APP_URL), so nginx keeps the prefix (proxy_pass without a URI).
    # Arcane then signs in through the hub's OIDC provider (/oidc): no second password.
    # Arcane's public static PWA files, without the login gate: browsers fetch the manifest without cookies, and
    # Chrome may send none with the service worker script, which then cannot be registered behind a redirect.
    # Same files as in every Arcane release (Arcane serves them without login). Arcane gets a fixed, clean path
    # (not the client's raw URI), so an encoded "../" cannot reach anything else through these.
    location = /arcane/service-worker.js {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:{{ARCANE_PORT}}/arcane/service-worker.js;
        include /etc/nginx/sparkhub/proxy-headers.inc;
    }
    location = /arcane/app.webmanifest {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:{{ARCANE_PORT}}/arcane/app.webmanifest;
        include /etc/nginx/sparkhub/proxy-headers.inc;
    }
    location = /arcane/arcane-mobile-passkey.json {             # cached by the service worker at install
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:{{ARCANE_PORT}}/arcane/arcane-mobile-passkey.json;
        include /etc/nginx/sparkhub/proxy-headers.inc;
    }
    location ~ ^/arcane/api/app-images/pwa/([A-Za-z0-9][A-Za-z0-9._-]*\.png)$ {   # the manifest's icons
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:{{ARCANE_PORT}}/arcane/api/app-images/pwa/$1;
        include /etc/nginx/sparkhub/proxy-headers.inc;
    }

    location /arcane/ {
        auth_request /_auth;
        error_page 401 = @login;
        proxy_pass http://127.0.0.1:{{ARCANE_PORT}};
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Upgrade $http_upgrade;            # stats, logs and terminal websockets
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;                               # event streams
        proxy_read_timeout 3600s;
        client_max_body_size 512m;                         # image and file uploads
    }

{{/ARCANE}}
{{#CHATUI}}
    # Web chat (chat-ui), built for /chat (APP_BASE), so the prefix is kept. Behind the hub login like the admin tools;
    # 403 from the check = turned off on the Settings page. chat-ui then signs in through the hub's OIDC provider.
    location = /_auth_chat {
        internal;
        proxy_pass http://hub/auth/check-chat;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header X-Original-URI $request_uri;
    }
    location @chat_off {
        rewrite ^ /chat-off break;
        proxy_pass http://hub;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
    }
    location = /chat { return 301 /chat/; }
    location /chat/ {
        auth_request /_auth_chat;
        error_page 401 = @login;
        error_page 403 = @chat_off;
        proxy_pass http://127.0.0.1:{{CHATUI_PORT}};
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Connection "";
        proxy_buffering off;                               # streamed answers
        proxy_read_timeout 1800s;
        client_max_body_size 16m;                          # chat-ui's BODY_SIZE_LIMIT (15 MiB) for uploads
        # The browser may load nothing from other sites: chat-ui shows avatars from huggingface.co (sending the
        # username there), and later versions may add more. add_header here replaces the server's, so HSTS again.
        add_header Content-Security-Policy "img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; media-src 'self' data: blob:; frame-ancestors 'self'" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

{{/CHATUI}}
{{#NVIDIA_DASHBOARD}}
    # NVIDIA DGX Dashboard (127.0.0.1:{{NVIDIA_DASHBOARD_PORT}}). It is built for "/" only, so its absolute paths are rewritten to
    # /nvidia/... on the way out (sub_filter). Its own login stays as a second layer. Re-check after DGX OS updates.
    location /nvidia/ {
        auth_request /_auth;
        error_page 401 = @login;
        proxy_pass http://127.0.0.1:{{NVIDIA_DASHBOARD_PORT}}/;
        include /etc/nginx/sparkhub/proxy-headers.inc;
        proxy_set_header Accept-Encoding "";               # sub_filter needs uncompressed bodies
        proxy_buffering off;                               # telemetry and update logs are event streams
        proxy_read_timeout 3600s;
        proxy_redirect / /nvidia/;
        sub_filter_types text/javascript application/javascript text/css;
        sub_filter_once off;
        sub_filter '"basename":"/"' '"basename":"/nvidia/"';
        sub_filter '"/assets/' '"/nvidia/assets/';
        sub_filter 'url(/assets/' 'url(/nvidia/assets/';
        sub_filter '"/api/' '"/nvidia/api/';
        sub_filter '"/locales/' '"/nvidia/locales/';
        sub_filter '"/customize/' '"/nvidia/customize/';
        sub_filter '"/favicon.ico"' '"/nvidia/favicon.ico"';
    }
{{/NVIDIA_DASHBOARD}}
