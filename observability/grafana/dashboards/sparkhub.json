{
 "uid": "sparkhub",
 "title": "SparkHub",
 "tags": [
  "sparkhub"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Mode",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "state-timeline",
   "title": "Loaded mode",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mode) (sparkhub_mode{state=\"ready\"})",
     "legendFormat": "{{mode}}",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (state) (sparkhub_mode{state!=\"ready\"})",
     "legendFormat": "{{state}}",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "color": {
      "mode": "palette-classic"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "on"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8
   },
   "description": "Which mode was loaded, and when a switch or failure was in progress."
  },
  {
   "type": "timeseries",
   "title": "Switches",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (to, result) (increase(sparkhub_switches_total[1h]))",
     "legendFormat": "{{to}} {{result}}",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Model load time",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sparkhub_model_load_seconds_sum / sparkhub_model_load_seconds_count",
     "legendFormat": "{{mode}} avg",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(280)",
     "legendFormat": "fast bench 280 s",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(210)",
     "legendFormat": "quality bench 210 s",
     "range": true
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*bench.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "row",
