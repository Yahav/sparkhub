{
 "uid": "system",
 "title": "System",
 "tags": [
  "sparkhub",
  "system"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Memory (unified: CPU and GPU share it)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Memory",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_Cached_bytes",
     "legendFormat": "page cache",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
     "legendFormat": "swap used",
     "range": true
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(78490527334.4)",
     "legendFormat": "fast bench 73.1 GiB",
     "range": true
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(109092169318.4)",
     "legendFormat": "quality bench 101.6 GiB",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 16,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "bytes"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*bench.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "gauge",
   "title": "Memory used now",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "used",
     "range": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.9
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "GPU (nvidia-smi via the hub)",
   "id": 4,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "GPU temperature",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sparkhub_gpu_temperature_celsius",
     "legendFormat": "\u00b0C",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "celsius"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "GPU power",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sparkhub_gpu_power_watts",
     "legendFormat": "W",
     "range": true
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 11,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "watt"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "GPU busy",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sparkhub_gpu_utilization_percent",
     "legendFormat": "%",
     "range": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 11,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "row",
   "title": "CPU, disk, network",
   "id": 8,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU busy",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
     "legendFormat": "all cores",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Disk I/O",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_disk_read_bytes_total[2m]))",
     "legendFormat": "read",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_disk_written_bytes_total[2m]))",
     "legendFormat": "write",
     "range": true
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Network",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[2m]))",
     "legendFormat": "in",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[2m]))",
     "legendFormat": "out",
     "range": true
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "bargauge",
   "title": "Disk space used",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}",
     "legendFormat": "{{mountpoint}}",
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 }
}
